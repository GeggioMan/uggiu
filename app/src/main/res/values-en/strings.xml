    <string name="help_title">Help &amp; Troubleshooting</string>
    <string name="help_band_not_connected_title">Band not connected?</string>
    <string name="help_band_not_connected_desc">Check that \'Share HR\' (Settings > Heart Rate Broadcast) is active on the band. Ensure Bluetooth is on.</string>
    <string name="help_battery_not_visible_title">Battery not visible?</string>
    <string name="help_battery_not_visible_desc">Not all bands support battery reading via standard Bluetooth. If available, it will appear automatically after connection.</string>
    <string name="help_permissions_title">Permissions</string>
    <string name="help_permissions_desc">Make sure you have granted Bluetooth, Location and Body Sensors permissions in your smartphone settings.</string>
    <string name="help_background_title">Background</string>
    <string name="help_background_desc">To avoid disconnections, set the \'uggiu\' app to \'Unrestricted\' in your smartphone\'s battery settings.</string>
